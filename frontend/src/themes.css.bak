/* ============================================================
   FreightIQ — Themes and Design Tokens
   ============================================================ */

/* ----- Default (Dark Mode) ----- */
:root {
  /* Background Scale — desaturated near-black */
  --bg-primary: hsl(0, 0%, 4%);
  --bg-secondary: hsl(0, 0%, 7%);
  --bg-card: hsla(0, 0%, 10%, 0.7);
  --bg-card-hover: hsla(0, 0%, 13%, 0.8);
  --bg-elevated: hsla(0, 0%, 9%, 0.85);
  --bg-input: hsla(0, 0%, 11%, 0.6);
  --bg-sidebar: hsla(0, 0%, 5%, 0.95);

  /* Accent — single cool cyan */
  --accent: hsl(192, 80%, 55%);
  --accent-dim: hsl(192, 60%, 35%);
  --accent-glow: hsla(192, 80%, 55%, 0.18);
  /* Legacy aliases for existing class references */
  --accent-ocean: var(--accent);
  --accent-ocean-dim: var(--accent-dim);
  --accent-ocean-glow: var(--accent-glow);
  --accent-violet: var(--accent);

  /* Functional colors */
  --accent-emerald: hsl(155, 70%, 45%);
  --accent-emerald-dim: hsl(155, 55%, 30%);
  --accent-amber: hsl(35, 95%, 60%);
  --accent-amber-dim: hsl(35, 80%, 40%);
  --accent-rose: hsl(0, 80%, 60%);
  --accent-rose-dim: hsl(0, 65%, 40%);

  /* Text — pure neutral */
  --text-primary: hsl(0, 0%, 95%);
  --text-secondary: hsl(0, 0%, 55%);
  --text-muted: hsl(0, 0%, 38%);
  --text-inverse: hsl(0, 0%, 4%);

  /* Borders */
  --border-subtle: hsla(0, 0%, 20%, 0.4);
  --border-active: hsla(192, 80%, 55%, 0.4);

  /* Glass Effect */
  --glass-blur: 12px;
  --glass-border: 1px solid hsla(0, 0%, 22%, 0.25);
  --glass-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);

  /* Typography */
  --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-serif: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-size-xs: 0.7rem;
  --font-size-sm: 0.8rem;
  --font-size-base: 0.9rem;
  --font-size-md: 1rem;
  --font-size-lg: 1.15rem;
  --font-size-xl: 1.4rem;
  --font-size-2xl: 1.8rem;
  --font-size-3xl: 2.4rem;

  /* Spacing */
  --space-xs: 4px;
  --space-sm: 8px;
  --space-md: 16px;
  --space-lg: 24px;
  --space-xl: 32px;
  --space-2xl: 48px;

  /* Radius */
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 14px;
  --radius-xl: 20px;
  --radius-full: 9999px;

  /* Transitions */
  --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
  --transition-base: 250ms cubic-bezier(0.4, 0, 0.2, 1);
  --transition-slow: 400ms cubic-bezier(0.4, 0, 0.2, 1);

  /* Sidebar */
  --sidebar-width: 260px;
  --sidebar-collapsed: 72px;
  --header-height: 60px;
}

/* ----- Light Mode Override ----- */
:root[data-theme='light'] {
  --bg-primary: hsl(0, 0%, 97%);
  --bg-secondary: hsl(0, 0%, 93%);
  --bg-card: hsla(0, 0%, 100%, 0.85);
  --bg-card-hover: hsla(0, 0%, 100%, 0.95);
  --bg-elevated: hsla(0, 0%, 100%, 0.94);
  --bg-input: hsla(0, 0%, 98%, 0.9);
  --bg-sidebar: hsla(0, 0%, 98%, 0.96);

  --accent: hsl(192, 80%, 40%);
  --accent-dim: hsl(192, 60%, 25%);
  --accent-glow: hsla(192, 80%, 40%, 0.15);

  --accent-ocean: var(--accent);
  --accent-ocean-dim: var(--accent-dim);
  --accent-ocean-glow: var(--accent-glow);
  --accent-violet: var(--accent);

  --accent-emerald: hsl(155, 70%, 35%);
  --accent-emerald-dim: hsl(155, 55%, 25%);
  --accent-amber: hsl(35, 95%, 45%);
  --accent-amber-dim: hsl(35, 80%, 30%);
  --accent-rose: hsl(0, 80%, 50%);
  --accent-rose-dim: hsl(0, 65%, 35%);

  --text-primary: hsl(0, 0%, 10%);
  --text-secondary: hsl(0, 0%, 38%);
  --text-muted: hsl(0, 0%, 52%);
  --text-inverse: hsl(0, 0%, 100%);

  --border-subtle: hsla(0, 0%, 60%, 0.3);
  --border-active: hsla(192, 80%, 42%, 0.45);

  --glass-border: 1px solid hsla(0, 0%, 60%, 0.2);
  --glass-shadow: 0 1px 4px hsla(0, 0%, 0%, 0.08);
}